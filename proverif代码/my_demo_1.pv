(************************************************************)
(* ProVerif model for: Chebyshev-map based authentication   *)
(* Roles: EndDevice (Dev) and TrustCenter (TC)               *)
(* Added: session key ks secrecy + agreement (KeyDev/KeyTC)  *)
(************************************************************)

free c : channel.                 (* public channel *)

(* ------------ Basic types ------------- *)
type entity.

(* ------------ Public parameters ------------- *)
const x  : bitstring.
const N  : bitstring.
const PK : bitstring.

(* ------------ Long-term secrets (private) ------------- *)
free SK    : bitstring [private].
free AuthK : bitstring [private].

(* User/device factors (kept private) *)
free ID  : bitstring [private].
free PW  : bitstring [private].
free Bio : bitstring [private].

(* Payload protected after handshake (to test secrecy) *)
free secrets : bitstring [private].

(* ------------ Crypto primitives ------------- *)

(* Hash and XOR *)
fun Hash(bitstring) : bitstring.
fun XOR(bitstring, bitstring) : bitstring.
equation forall a:bitstring, b:bitstring; XOR(XOR(a,b),b) = a.

(* Simple concatenation helpers *)
fun c2(bitstring, bitstring) : bitstring.
fun c3(bitstring, bitstring, bitstring) : bitstring.
fun c4(bitstring, bitstring, bitstring, bitstring) : bitstring.

(* Chebyshev map abstraction: T(n, x) *)
fun T(bitstring, bitstring) : bitstring.

(* “Addition” abstraction used in the 3-step random check *)
fun plus(bitstring, bitstring) : bitstring.

(* Asymmetric encryption for (PID,PW,A) part:
   DevK = pk(AuthK), TC decrypts with AuthK *)
fun pk(bitstring) : bitstring.
fun aenc(bitstring, bitstring) : bitstring.
fun adec(bitstring, bitstring) : bitstring.
equation forall m:bitstring, sk:bitstring; adec(aenc(m, pk(sk)), sk) = m.

(* ------------ Events for authentication ------------- *)
event AuthDevBegin(bitstring).   (* parameter: PID *)
event AuthDevEnd(bitstring).
event AuthTCBegin(bitstring).
event AuthTCEnd(bitstring).

(* ------------ Events for key agreement ------------- *)
event KeyDev(bitstring, bitstring).   (* (PID, ks) at device *)
event KeyTC(bitstring, bitstring).    (* (PID, ks) at TC *)

(* ------------ Security queries ------------- *)

(* authentication (injective correspondence) *)
query p:bitstring; inj-event(AuthDevEnd(p)) ==> inj-event(AuthDevBegin(p)).
query p:bitstring; inj-event(AuthTCEnd(p))  ==> inj-event(AuthTCBegin(p)).

(* long-term secrecy goals *)
(* query attacker(secrets). *)   (* disabled for faster verification *)
query attacker(ID).
query attacker(PW).
query attacker(Bio).

(* session key secrecy / agreement *)
(* Disabled for faster verification. Re-enable when needed. *)
(* query p:bitstring, k:bitstring; event(KeyDev(p,k)) ==> attacker(k). *)
(* query p:bitstring, k:bitstring; event(KeyTC(p,k)) ==> attacker(k). *)
(* query p:bitstring, k:bitstring; event(KeyDev(p,k)) ==> event(KeyTC(p,k)). *)
(* query p:bitstring, k:bitstring; event(KeyTC(p,k)) ==> event(KeyDev(p,k)). *)

(* stronger (injective) key agreement (optional but recommended)
   Disabled for faster verification. Re-enable for full guarantees.
*)
(* query p:bitstring, k:bitstring; inj-event(KeyDev(p,k)) ==> inj-event(KeyTC(p,k)). *)
(* query p:bitstring, k:bitstring; inj-event(KeyTC(p,k))  ==> inj-event(KeyDev(p,k)). *)

(************************************************************)
(* Role: EndDevice                                           *)
(* Implements: M1 -> M2 -> M3 -> M4 and derives session key   *)
(************************************************************)
let EndDevice(DevK:bitstring, PID:bitstring, A:bitstring) =
  (* M1: Dev -> TC : QID,QPW,QA,mac1 *)

  (* Encrypt PID,PW,A under DevK (=pk(AuthK)) *)
  let QID = aenc(PID, DevK) in
  let QPW = aenc(PW,  DevK) in
  let QA  = aenc(A,   DevK) in
  let mac1 = Hash(c3(QID, QPW, QA)) in

  event AuthDevBegin(PID);
  out(c, (QID, QPW, QA, mac1));

  (* Receive M2: { QID', N1, mac2 } *)
  in(c, (QIDp:bitstring, N1:bitstring, mac2:bitstring));
  if mac2 = Hash(c2(QIDp, N1)) then

    (* AT_PK = T(A, PK); recover QID and Authr from XOR masking *)
    let AT_PK = T(A, PK) in
    let QID_rec = XOR(QIDp, AT_PK) in
    let Authr   = XOR(N1,   AT_PK) in

    (* M3: Dev -> TC
       N2 = rDev XOR AT_PK
       DevSum = plus(Authr, rDev), masked as T(DevSum,PK) (abstract)
    *)
    new rDev:bitstring;
    let N2 = XOR(rDev, AT_PK) in
    let DevSum = plus(Authr, rDev) in
    let DevSumEnc = T(DevSum, PK) in
    let mac3 = Hash(c3(N2, DevSumEnc, QID_rec)) in
    out(c, (N2, DevSumEnc, QID_rec, mac3));

    (* Receive M4: { AuthSumEnc, QID', mac4 } *)
    in(c, (AuthSumEnc:bitstring, QIDp2:bitstring, mac4:bitstring));
    if mac4 = Hash(c2(AuthSumEnc, QIDp2)) then

      (* Session key:
         ks = Hash( T(SK, T(A,x)) || Authr || rDev )
      *)
      let chebPart = T(SK, T(A, x)) in
      let ks = Hash(c3(chebPart, Authr, rDev)) in

      (* key derivation event *)
      event KeyDev(PID, ks);

      (* Example: protect secrets after handshake (disabled for speed) *)
      (* out(c, aenc(secrets, pk(ks))); *)

      event AuthDevEnd(PID)
    else 0
  else 0.

(************************************************************)
(* Role: TrustCenter                                         *)
(* Stores {PID -> V} where V = T(SK,T(A,x))                   *)
(* Validates Dev by comparing computed V with stored V        *)
(************************************************************)
let TrustCenter() =
  (* --- Registration (abstracted as local secure initialization) --- *)
  new L:bitstring;
  let PID = Hash(c3(ID, L, Bio)) in
  let A   = Hash(c4(ID, PW, Bio, L)) in
  let V   = T(SK, T(A, x)) in

  (* DevK is public key for encrypting PID,PW,A in M1 *)
  let DevK = pk(AuthK) in

  (* --- Authentication begins --- *)
  in(c, (QID:bitstring, QPW:bitstring, QA:bitstring, mac1:bitstring));
  if mac1 = Hash(c3(QID, QPW, QA)) then

    (* Decrypt *)
    let PID2 = adec(QID, AuthK) in
    let PW2  = adec(QPW, AuthK) in
    let A2   = adec(QA,  AuthK) in

    (* Check stored verification value V equals recomputed value *)
    let V2 = T(SK, T(A2, x)) in
    if V2 = V then

      (* TC accepted the device *)
      event AuthTCBegin(PID2);

      (* M2: TC -> Dev
         choose Authr, mask with AT_PK = T(A2,PK)
      *)
      new Authr:bitstring;
      let AT_PK = T(A2, PK) in
      let QIDp  = XOR(QID, AT_PK) in
      let N1    = XOR(Authr, AT_PK) in
      let mac2  = Hash(c2(QIDp, N1)) in
      out(c, (QIDp, N1, mac2));

      (* Receive M3: {N2, DevSumEnc, QID_rec, mac3} *)
      in(c, (N2:bitstring, DevSumEnc:bitstring, QID_rec:bitstring, mac3:bitstring));
      if mac3 = Hash(c3(N2, DevSumEnc, QID_rec)) then

        (* Recover rDev from N2 *)
        let rDev = XOR(N2, AT_PK) in

        (* (Optional) check DevSumEnc == T(plus(Authr,rDev),PK)
           NOTE: With abstract plus/T we can still compare terms syntactically.
           If you want this check enabled, uncomment:
           if DevSumEnc = T(plus(Authr, rDev), PK) then ...
        *)

        (* prepare M4 *)
        let AuthSum = plus(Authr, rDev) in
        let AuthSumEnc = T(AuthSum, PK) in
        let mac4 = Hash(c2(AuthSumEnc, QIDp)) in
        out(c, (AuthSumEnc, QIDp, mac4));

        (* TC derives session key using stored V *)
        let ks_tc = Hash(c3(V, Authr, rDev)) in
        event KeyTC(PID2, ks_tc);

        event AuthTCEnd(PID2)
      else 0
    else 0
  else 0.

(************************************************************)
(* Main process                                              *)
(************************************************************)
process
  (* FAST MODE: single session to speed up verification.
     Replace with replication (!TrustCenter / !EndDevice) for unbounded sessions.
  *)
  ( TrustCenter() )
  |
  ( new L0:bitstring;
    let PID0 = Hash(c3(ID, L0, Bio)) in
    let A0   = Hash(c4(ID, PW, Bio, L0)) in
    let DevK0 = pk(AuthK) in
    EndDevice(DevK0, PID0, A0)
  )
